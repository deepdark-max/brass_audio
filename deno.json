{
  "name": "@brass/audio",
  "version": "0.1.0",
  "description": "An audio playback library for Deno, based on miniaudio",
  "exports": {
    ".": "./mod.ts"
  },
  "license": "MIT",
  "keywords": [
    "audio",
    "miniaudio",
    "ffi",
    "deno",
    "sound",
    "playback",
    "game"
  ],
  "publish": {
    "include": [
      "deno.json",
      "README.md",
      "mod.ts",
      "build/**/*.ts",
      "src/**/*.ts"
    ],
    "exclude": [
      "native/",
      "test/",
      "examples/"
    ]
  },
  "tasks": {
    "example:play": "deno run -A examples/play.ts",
    "build:windows": "deno run -A native/windows/build.ts",
    "build:linux":   "deno run -A native/linux/build.ts",
    "build:darwin":  "deno run -A native/darwin/build.ts",
    "build:all":     "deno run -A native/windows/build.ts && deno run -A native/linux/build.ts && deno run -A native/darwin/build.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  }
}
